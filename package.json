{
  "name": "@mrfinch/booking",
  "description": "A booking component for Convex.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Finchmedia/booking-component.git"
  },
  "homepage": "https://github.com/Finchmedia/booking-component#readme",
  "bugs": {
    "url": "https://github.com/Finchmedia/booking-component/issues"
  },
  "version": "0.4.1",
  "license": "Apache-2.0",
  "keywords": [
    "convex",
    "component"
  ],
  "type": "module",
  "scripts": {
    "prepare": "npm run build",
    "dev": "run-p -r 'dev:*'",
    "dev:backend": "convex dev --typecheck-components",
    "dev:frontend": "cd example && vite --clearScreen false",
    "dev:build": "chokidar 'tsconfig*.json' 'src/**/*.ts' -i '**/*.test.ts' -c 'npx convex codegen --component-dir ./src/component && npm run build' --initial",
    "predev": "path-exists .env.local || (npm run build && convex dev --until-success)",
    "clean": "rm -rf dist *.tsbuildinfo",
    "build": "tsc --project ./tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p example && tsc -p example/convex",
    "lint": "eslint .",
    "all": "run-p -r 'dev:*' 'test:watch'",
    "test": "vitest run --typecheck",
    "test:watch": "vitest --typecheck --clearScreen false",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:coverage": "vitest run --coverage --coverage.reporter=text",
    "prepublishOnly": "npm run clean && npm run build && npm run test && npm run typecheck && npm run lint"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./test": "./src/test.ts",
    "./_generated/component.js": {
      "types": "./dist/component/_generated/component.d.ts",
      "default": "./dist/component/_generated/component.js"
    },
    "./_generated/component": {
      "types": "./dist/component/_generated/component.d.ts",
      "default": "./dist/component/_generated/component.js"
    },
    "./convex.config.js": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./convex.config": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    }
  },
  "peerDependencies": {
    "@hookform/resolvers": "^5.9.1",
    "convex": "^1.46.0",
    "convex-helpers": "^0.1.124",
    "lucide-react": "^1.47.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-hook-form": "^7.88.0"
  },
  "peerDependenciesMeta": {
    "@hookform/resolvers": {
      "optional": true
    },
    "convex-helpers": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-hook-form": {
      "optional": true
    }
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^5.0.0",
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "10.0.1",
    "@hookform/resolvers": "^5.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "chokidar-cli": "^3.0.0",
    "convex": "1.46.0",
    "convex-helpers": "^0.1.124",
    "convex-test": "0.0.59",
    "cpy-cli": "^7.0.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "lucide-react": "^1.47.0",
    "npm-run-all2": "^9.0.3",
    "path-exists-cli": "^2.0.0",
    "pkg-pr-new": "^0.0.88",
    "prettier": "^3.9.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "types": "./dist/client/index.d.ts",
  "module": "./dist/client/index.js",
  "dependencies": {
    "@convex-dev/resend": "^0.2.8",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "zod": "^4.6.5"
  }
}
